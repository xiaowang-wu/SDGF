{
  "data": {
    "path": "examples/demo.csv",
    "time_column": "timestamp",
    "expected_frequency": "1h",
    "target": "load",
    "ts_features": [
      "load",
      "temperature"
    ],
    "static_features": [
      "hour_sin",
      "hour_cos",
      "is_weekend"
    ],
    "train_ratio": 0.7,
    "val_ratio": 0.15
  },
  "model": {
    "dynamic_hidden_dims": [
      64,
      32
    ],
    "dropout": 0.1,
    "use_feature_attention": true
  },
  "training": {
    "epochs": 30,
    "batch_size": 32,
    "seed": 42
  }
}
