{
  "data": {
    "path": "data/load_1.csv",
    "time_column": "datetime",
    "expected_frequency": "1h",
    "target": "nat_demand",
    "ts_features": [
      "T2M_toc",
      "QV2M_toc",
      "TQL_toc",
      "W2M_toc",
      "T2M_san",
      "QV2M_san",
      "TQL_san",
      "W2M_san",
      "T2M_dav",
      "QV2M_dav",
      "TQL_dav",
      "W2M_dav",
      "nat_demand"
    ],
    "static_features": [
      "Holiday_ID",
      "holiday",
      "school",
      "hour_sin",
      "hour_cos",
      "month_sin",
      "month_cos",
      "is_weekend"
    ],
    "train_ratio": 0.7,
    "val_ratio": 0.15
  },
  "training": {
    "epochs": 500,
    "batch_size": 128,
    "lr_static": 0.001,
    "lr_main": 0.001,
    "lr_dynamic": 0.0003,
    "weight_decay": 2e-05,
    "patience": 10,
    "min_delta": 1e-06,
    "use_huber": true,
    "use_scheduler": true,
    "scheduler_t0": 30,
    "scheduler_t_mult": 2,
    "eta_min": 1e-06,
    "seed": 42,
    "deterministic": true,
    "num_threads": 1
  },
  "model": {
    "dynamic_hidden_dims": [
      64,
      32
    ],
    "dropout": 0.1,
    "use_feature_attention": true
  }
}
